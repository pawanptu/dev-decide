{
  "notes": [
    "The payments service is PCI scoped; any change there needs a second reviewer.",
    "We use Postgres 16 with Prisma migrations and deploy on weekdays only."
  ],
  "critical_paths": {
    "src/payments/**": 4,
    "prisma/migrations/**": {"risk": 4},
    "**/auth/**": 4,
    ".github/workflows/**": 3,
    "infra/**": {"risk": 3}
  },
  "thresholds": {
    "default": 0.6,
    "severity": 0.7,
    "route": 0.5
  },
  "backend": "auto",
  "model": {"cli": "haiku", "api": "claude-haiku-5-5"},
  "capture": "hashed",
  "cache_ttl_hours": 24,
  "router_hook": {"min_confidence": 0.6, "min_margin": 0.2, "builtins": false},
  "routes": {
    "builtins": true,
    "exclude": ["statusline-setup"],
    "extra": [
      {"name": "ask-human", "kind": "custom", "description": "Escalate to the on-call engineer when no agent or skill fits"}
    ]
  },
  "presets": {
    "choose": {
      "service": {"options": ["web", "api", "worker", "billing"]}
    }
  },
  "bundles": {
    "release": ["risk", "breaking_change", "migration_required", "rollback_safe"]
  },
  "gates": {
    "release": {
      "requires": ["risk", "rollback_safe"],
      "block": ["rollback_safe.p_true < 0.3"],
      "review": ["risk.score >= 3.5", "migration_required.p_true >= 0.5"]
    }
  },
  "log": true
}
