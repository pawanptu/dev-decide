{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/dev-decide/scripts/run.sh\" hookd.py --ensure",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47321/route",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Skill",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47321/tool",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
